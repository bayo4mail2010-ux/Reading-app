{
  "name": "Reading App — Godot + Dart",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Godot Editor (noVNC)",
      "onAutoForward": "openBrowser"
    }
  }
}
