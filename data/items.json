    "item_id": "adventure_door",
    "skill_id": "choose_your_adventure",
    "difficulty_weight": 4,
    "startNode": "start",
    "nodes": {
      "start": {
        "text": "You find a mystery door in your backyard. It is red and locked.",
        "choices": [
          {
            "label": "Look for a key",
            "next": "key_path"
          },
          {
            "label": "Knock on the door",
            "next": "knock_path"
          }
        ]
      },
      "key_path": {
        "text": "You find a shiny gold key under a rock!",
        "choices": [
          {
            "label": "Open the door",
            "next": "end_open"
          },
          {
            "label": "Keep the key and go home",
            "next": "end_keep"
          }
        ]
      },
      "knock_path": {
        "text": "You hear a friendly voice say hello!",
        "choices": [
          {
            "label": "Ask who it is",
            "next": "end_ask"
          },
          {
            "label": "Run away",
            "next": "end_run"
          }
        ]
      },
      "end_open": {
        "text": "The door opens to a room full of toys! What a great day!",
        "isEnding": true
      },
      "end_keep": {
        "text": "You keep the key safe for another day. The end.",
        "isEnding": true
      },
      "end_ask": {
        "text": "It's a talking cat! You make a new friend.",
        "isEnding": true
      },
      "end_run": {
        "text": "You run home for dinner. Maybe next time!",
        "isEnding": true
      }
    }
  },{
    "item_id": "adventure_puppy",
    "skill_id": "choose_your_adventure",
