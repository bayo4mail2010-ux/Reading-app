        ]
      },
      "pet_path": {
        "text": "The puppy licks your hand and wags its tail!",
        "choices": [
          {
            "label": "Take the puppy home",
            "next": "end_home"
          },
          {
            "label": "Play fetch first",
            "next": "end_fetch"
          }
        ]
      },
      "help_path": {
        "text": "You find a kind park ranger nearby.",
        "choices": [
          {
            "label": "Tell the ranger about the puppy",
            "next": "end_ranger"
          },
          {
            "label": "Look for the owner yourself",
            "next": "end_search"
          }
        ]
      },
      "end_home": {
        "text": "You give the puppy a warm home. It is so happy!",
        "isEnding": true
      },
      "end_fetch": {
        "text": "You and the puppy play all afternoon. Best day ever!",
        "isEnding": true
