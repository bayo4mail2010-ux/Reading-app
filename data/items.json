    "startNode": "start",
    "nodes": {
      "start": {
        "text": "You see a lost puppy in the park. It looks scared.",
        "choices": [
          {
            "label": "Pet the puppy gently",
            "next": "pet_path"
          },
          {
            "label": "Go find help",
            "next": "help_path"
